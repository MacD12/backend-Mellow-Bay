# Helio PMS — API configuration
#
#   cp .env.example .env      then edit
#
# GENERATED FROM src/config.ts — do not edit by hand.
# Run `npm run config:example` after changing the schema.
#
# Every variable here has a working default except HELIO_SECRET_KEY, which has
# none and is the one you must set before going live.
#
# Files are read in this order, each overriding the one before it, and the real
# environment overrides all of them:
#
#     .env                .env.local            (this machine, never committed)
#     .env.<mode>         .env.<mode>.local     (mode is NODE_ENV)
#
# Check what the server resolved with:  npm run config

# ─── Server ────────────────────────────────────────────────────

# TCP port the API listens on.
# optional · a whole number between 1 and 65535
# default: 8080
# PORT=8080

# Comma-separated list of web origins allowed to call this API. Set it to
# exactly the address the front end is served from; anything not on the list
# gets a browser CORS failure that looks, from the app, identical to the
# server being down.
# optional · a comma-separated list of a URL (http or https)
# default: http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,https://main.d2ghlmlthkq8hn.amplifyapp.com
# CORS_ORIGIN=https://pms.example.com

# ─── Storage ───────────────────────────────────────────────────

# SQLite file holding everything — reservations, folios, audit trail.
# Relative paths resolve against the backend directory. The file and its
# directory are created on first boot.
# optional · a filesystem path
# default: ./data/helio.db
# HELIO_DB=./data/helio.db

# Whether the scheduled snapshot job runs. Turning this off on a machine
# holding real bookings leaves the database as the only copy.
# optional · true or false
# default: true
# HELIO_BACKUP_ENABLED=true

# Where snapshots are written. Defaults to a sibling of the database
# directory (so it follows HELIO_DB rather than staying put), which means a
# backup survives losing the data directory but not the disk — point it at
# other storage for that.
# optional · a filesystem path
# HELIO_BACKUP_DIR=./backups

# Hours between scheduled snapshots. This is also the worst-case amount of
# work a restore can lose.
# optional · a whole number between 1 and 168
# default: 6
# HELIO_BACKUP_INTERVAL_HOURS=6

# ─── Secrets ───────────────────────────────────────────────────

# Encrypts channel and payment credentials at rest. Without it they are
# stored as clear text in the database and therefore in every backup.
# Generate one with: node -e
# "console.log(require('crypto').randomBytes(32).toString('hex'))". Losing
# it makes existing encrypted credentials unreadable, so keep it with your
# other secrets and not in the repository.
# required in production · a secret of at least 16 characters
HELIO_SECRET_KEY=

# Shared secret used to verify inbound channel webhooks. When it is absent,
# webhook signatures are not checked and anyone who can reach the endpoint
# can post a booking into your system.
# optional · a secret of at least 16 characters
# HELIO_WEBHOOK_SECRET=

# ─── Channel manager ───────────────────────────────────────────

# Base URL of the channel manager API. Only worth changing to point at a
# sandbox or a recorded fixture server during testing.
# optional · a URL (http or https)
# default: https://api.beds24.com/v2
# BEDS24_API=https://api.beds24.com/v2

# A long-lived refresh token connects the channel on startup with no UI
# step. It controls your entire OTA distribution — rates, availability and
# bookings — so treat it like a password. Only used when the installation
# has exactly one property; with several, connect from the channel manager
# screen so the right one is chosen.
# optional · a secret of at least 8 characters
# BEDS24_REFRESH_TOKEN=

# How long any single channel call may take before it is abandoned. Too low
# and a slow but healthy OTA looks like an outage; too high and a hung call
# holds up the queue behind it.
# optional · a whole number between 1000 and 120000
# default: 20000
# BEDS24_TIMEOUT_MS=20000

# Stops the server pushing rates and availability to the OTAs. Use it on a
# staging copy of production data, where a push would overwrite the live
# property's inventory from a test machine.
# optional · true or false
# default: false
# HELIO_CHANNEL_READONLY=false

# What the distribution partner is called anywhere a user can read it. The
# default hides the supplier's name from customers; set it to the real name
# on an internal build where the setup instructions are easier to follow
# with it. Must match VITE_CHANNEL_HUB_NAME in the front end.
# optional · text (at least 1 characters, at most 60 characters)
# default: The channel manager
# HELIO_CHANNEL_HUB_NAME=The channel manager

# The label given to the automatically created channel record on a property
# that connects through a refresh token.
# optional · text (at least 1 characters, at most 60 characters)
# default: Distribution
# HELIO_CHANNEL_NAME=Distribution

# Base wait before a parked channel update is retried. The wait backs off
# from here up to a six-hour ceiling.
# optional · a whole number between 1 and 360
# default: 15
# HELIO_CHANNEL_RETRY_MINUTES=15

# How often the queue of pending channel updates is drained. A property with
# no connected channel does no work here at all. Set it to 0 to stop the
# drain entirely, which is what the verification suite does so a background
# push cannot interfere with a test.
# optional · a whole number between 5 and 3600, or 0 to switch it off
# default: 60
# HELIO_CHANNEL_DRAIN_SECONDS=60

# ─── Scheduled work ────────────────────────────────────────────

# How often new and changed OTA bookings are imported. Each poll asks only
# for what changed since the last successful import, so a quiet minute costs
# one small call. Set it to 0 to stop importing.
# optional · a whole number between 10 and 3600, or 0 to switch it off
# default: 60
# HELIO_BOOKING_POLL_SECONDS=60

# How often guest messages are pulled from the channels. Deliberately slower
# than the rate queue: messages are conversational rather than perishable,
# and each poll costs a channel credit per booking. Set it to 0 to stop
# polling.
# optional · a whole number between 30 and 3600, or 0 to switch it off
# default: 300
# HELIO_MESSAGE_POLL_SECONDS=300

# Whether the night audit runs by itself. It never forces: a property with
# arrivals that were neither checked in nor cancelled is left alone and
# raises a notification, because that is a judgement for a person.
# optional · true or false
# default: true
# HELIO_NIGHT_AUDIT_AUTO=true

# Local hour, in each property's own timezone, after which the automatic
# night audit may run.
# optional · a whole number between 0 and 23
# default: 3
# HELIO_NIGHT_AUDIT_HOUR=3

# How often the server checks whether any property is due its night audit.
# optional · a whole number between 1 and 1440
# default: 10
# HELIO_NIGHT_AUDIT_CHECK_MINUTES=10

# ─── Guest documents ───────────────────────────────────────────

# How many days after a guest departs their scanned identity document and
# signature are kept, after which they are deleted automatically. A passport
# scan is sensitive personal data and most data-protection law requires that
# it is not held longer than the purpose needs — check what your
# jurisdiction obliges you to keep and for how long before raising this.
# optional · a whole number between 1 and 3650
# default: 90
# HELIO_DOCUMENT_RETENTION_DAYS=90

# Largest single document the API will accept, in kilobytes, measured after
# encoding. The app shrinks a photo before sending it, so this is a backstop
# rather than the usual limit. Every document is stored inside the database
# and therefore inside every backup, so raising this raises the size of
# both.
# optional · a whole number between 64 and 4096
# default: 1536
# HELIO_DOCUMENT_MAX_KB=1536

# ─── Development scripts ───────────────────────────────────────

# Administrator account created by `npm run demo`.
# optional · text (at least 3 characters)
# default: hiran@mellowbay.com
# DEMO_EMAIL=hiran@mellowbay.com

# Password for the demo administrator. Never reuse a real one: the default
# is published in this repository.
# optional · text (at least 8 characters)
# default: Mellow2026
# DEMO_PASSWORD=

# Currency the demo property is created with.
# optional · text (at least 3 characters, at most 3 characters, a three-letter ISO currency code)
# default: USD
# DEMO_CURRENCY=USD

# IANA timezone the demo property is created in.
# optional · text (at least 3 characters)
# default: Asia/Colombo
# DEMO_TIMEZONE=Asia/Colombo

# Account the smoke and check scripts sign in as.
# optional · text (at least 3 characters)
# default: hiran@mellowbay.com
# SMOKE_EMAIL=hiran@mellowbay.com

# Password for the smoke-test account.
# optional · text (at least 8 characters)
# default: Mellow2026
# SMOKE_PASSWORD=
